<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>English 1 Study Guide - All Lessons</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap');
        body { font-family: 'Inter', sans-serif; }
        .tab-content { display: none; }
        .tab-content.active { display: block; }
        .animate-fade-in { animation: fadeIn 0.4s ease-out; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
        .word-card:hover .word-korean { opacity: 1; }
        .word-korean { transition: opacity 0.3s ease; opacity: 0; }
        
        /* Modal Styles */
        #infographic-modal { display: none; transition: opacity 0.3s ease; }
        #infographic-modal.active { display: flex; opacity: 1; }

        /* Lesson Card Hover */
        .lesson-card { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
        .lesson-card:hover { transform: translateY(-5px); border-color: #6366f1; }
    </style>
</head>
<body class="bg-slate-50 text-slate-900">

    <!-- Header -->
    <header class="bg-white border-b sticky top-0 z-50">
        <div class="max-w-4xl mx-auto px-4 py-4 flex flex-col md:flex-row justify-between items-center gap-4">
            <h1 class="text-xl font-bold text-indigo-700 flex items-center gap-2">
                <i data-lucide="book-open" class="text-indigo-600"></i>
                High School English 1
            </h1>
            <nav class="flex gap-1 sm:gap-2 overflow-x-auto pb-2 sm:pb-0 items-center">
                <a href="../index.html" class="px-3 py-1.5 rounded-full text-sm font-bold transition-all text-slate-600 hover:bg-slate-100 flex items-center gap-1">
                    <i data-lucide="home" size="16"></i>
                    Home
                </a>
                <div class="h-4 w-[1px] bg-slate-200 mx-1"></div>
                <button onclick="switchTab('home')" id="nav-home" class="nav-btn px-4 py-1.5 rounded-full text-sm font-bold transition-all bg-indigo-600 text-white shadow-md">Dashboard</button>
                
                <!-- Generic Lesson Sub-tabs (Hidden on Dashboard) -->
                <div id="lesson-tabs" class="hidden flex gap-1 sm:gap-2 ml-2 border-l pl-2 border-slate-200">
                    <button onclick="switchTab('vocabulary')" id="nav-vocabulary" class="nav-btn px-3 py-1.5 rounded-full text-sm font-bold transition-all text-slate-600 hover:bg-slate-100">Voca</button>
                    <button onclick="switchTab('grammar')" id="nav-grammar" class="nav-btn px-3 py-1.5 rounded-full text-sm font-bold transition-all text-slate-600 hover:bg-slate-100">Grammar</button>
                    <button onclick="switchTab('content')" id="nav-content" class="nav-btn px-3 py-1.5 rounded-full text-sm font-bold transition-all text-slate-600 hover:bg-slate-100">Content</button>
                </div>
            </nav>
        </div>
    </header>

    <main class="max-w-4xl mx-auto px-4 py-8">
        
        <!-- Section: Home (Dashboard) -->
        <div id="section-home" class="tab-content active animate-fade-in space-y-8">
            <div class="bg-gradient-to-br from-indigo-700 to-indigo-900 rounded-3xl p-10 text-white shadow-2xl relative overflow-hidden">
                <div class="relative z-10">
                    <h2 class="text-4xl font-extrabold mb-2 leading-tight">Study Dashboard</h2>
                    <p class="text-indigo-100 text-lg max-w-xl leading-relaxed">
                        학습할 레슨을 선택하세요. 각 레슨별로 핵심 어휘, 문법, 본문 내용이 준비되어 있습니다.
                    </p>
                </div>
                <div class="absolute right-[-40px] bottom-[-40px] opacity-10 hidden lg:block">
                    <i data-lucide="layout-dashboard" style="width: 250px; height: 250px;"></i>
                </div>
            </div>

            <!-- Lesson Grid (8 Items) -->
            <div id="lesson-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <!-- Generated by JS -->
            </div>
        </div>

        <!-- Section: Vocabulary -->
        <div id="section-vocabulary" class="tab-content animate-fade-in space-y-6">
            <div class="flex items-center gap-4 mb-4">
                <div class="p-3 bg-indigo-100 rounded-2xl text-indigo-600">
                    <i data-lucide="languages" size="28"></i>
                </div>
                <div>
                    <h2 id="voca-title" class="text-2xl font-bold italic underline decoration-indigo-300">Vocabulary</h2>
                    <p class="text-slate-500">단어 위에 마우스를 올리거나 터치하여 뜻을 확인하세요.</p>
                </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4" id="vocabulary-grid">
                <!-- Word Cards generated via JS -->
            </div>
        </div>

        <!-- Section: Grammar -->
        <div id="section-grammar" class="tab-content animate-fade-in space-y-8">
            <div class="flex items-center gap-4 mb-2">
                <div class="p-3 bg-emerald-100 rounded-2xl text-emerald-600">
                    <i data-lucide="file-code-2" size="28"></i>
                </div>
                <div>
                    <h2 id="grammar-title" class="text-2xl font-bold">Target Grammar</h2>
                    <p class="text-slate-500">해당 레슨의 핵심 문법 구조</p>
                </div>
            </div>
            <div id="grammar-list" class="space-y-6">
                <!-- Grammar Points generated via JS -->
            </div>
        </div>

        <!-- Section: Content -->
        <div id="section-content" class="tab-content animate-fade-in space-y-6">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-4">
                <div class="flex items-center gap-4">
                    <div class="p-3 bg-rose-100 rounded-2xl text-rose-600">
                        <i data-lucide="layout-list" size="28"></i>
                    </div>
                    <div>
                        <h2 id="content-title" class="text-2xl font-bold">Core Summary</h2>
                        <p class="text-slate-500">본문의 핵심 흐름 파악하기</p>
                    </div>
                </div>
                <button id="infographic-btn" onclick="openModal()" class="hidden items-center gap-2 px-5 py-2.5 bg-rose-500 text-white rounded-xl font-bold hover:bg-rose-600 transition-colors shadow-lg active:scale-95">
                    <i data-lucide="image" size="18"></i>
                    인포그래픽 보기
                </button>
            </div>
            <div id="content-list" class="space-y-4">
                <!-- Content Points generated via JS -->
            </div>
        </div>
    </main>

    <!-- Modal for Infographic -->
    <div id="infographic-modal" class="fixed inset-0 bg-black/80 z-[100] items-center justify-center p-4 backdrop-blur-sm overflow-y-auto" onclick="closeModal()">
        <div class="relative max-w-5xl w-full bg-white rounded-3xl overflow-hidden shadow-2xl animate-fade-in" onclick="event.stopPropagation()">
            <div class="p-4 border-b flex justify-between items-center bg-slate-50">
                <h3 id="modal-title" class="font-bold text-slate-800 flex items-center gap-2 italic">
                    <i data-lucide="image" class="text-indigo-600"></i>
                    Infographic
                </h3>
                <button onclick="closeModal()" class="p-2 hover:bg-slate-200 rounded-full transition-colors">
                    <i data-lucide="x" size="24" class="text-slate-500"></i>
                </button>
            </div>
            <div class="p-2 sm:p-6 flex justify-center bg-slate-100">
                <img id="modal-img" src="" alt="Infographic" class="max-h-[75vh] object-contain rounded-xl shadow-inner border border-slate-200">
            </div>
        </div>
    </div>

    <footer class="bg-white border-t py-8 mt-12">
        <div class="max-w-4xl mx-auto px-4 text-center text-slate-400 text-sm font-medium">
            <p>© 2024 Study Dashboard - High School English 1</p>
        </div>
    </footer>

